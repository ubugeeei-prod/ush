# Install checksum-verified release binaries. This is the editable installer.
use $bin::*
use std::env::{get, get_or}
use std::fs::{read_text, append_text, is_file, is_dir, mkdir_p, sha256, temp_dir}
use std::process::{args, exit}
use std::command::exists
use std::string::{split, lines, starts_with, trim_prefix, trim_suffix, replace, contains}
use std::io::eprint

fn option(name: String, legacy: String, fallback: String) -> String {
  get_or name (get_or legacy fallback)
}

fn usage() -> () {
  print "usage: install.sh [--version VERSION] [--bin-dir DIR] [--prefix DIR]"
  print "                  [--download-url URL] [--checksum-url URL] [--no-modify-path]"
  print "Install ush and ush_lsp. Example: sh install.sh --version v0.13.0"
}

fn need(command: String) -> () / unknown, stderr, exec {
  if exists command == false {
    fail 1 ("install.sh: " + command + " is required")
  }
}

fn target() -> String / unknown, stderr, exec, env {
  let os = uname "-s"
  let arch = uname "-m"
  match os {
    "Linux" => let os = "unknown-linux-gnu"
    "Darwin" => let os = "apple-darwin"
    _ => fail 1 ("install.sh: unsupported operating system: " + os)
  }
  match arch {
    "x86_64" => let arch = "x86_64"
    "amd64" => let arch = "x86_64"
    "arm64" => let arch = "aarch64"
    "aarch64" => let arch = "aarch64"
    _ => fail 1 ("install.sh: unsupported architecture: " + arch)
  }
  arch + "-" + os
}

fn path_contains(directory: String) -> Bool {
  contains (":" + get "PATH" + ":") (":" + directory + ":")
}

fn bin_directory(explicit: String, prefix: String) -> String / unknown, stderr, fs, exec, env {
  if explicit != "" {
    return explicit
  }
  if prefix != "" {
    return prefix + "/bin"
  }
  let home = get "HOME"
  for candidate in [home + "/.local/bin", home + "/bin"] {
    if path_contains candidate {
      return candidate
    }
  }
  for candidate in split (get "PATH") ":" {
    if starts_with candidate (home + "/") && test "-d" candidate && test "-w" candidate {
      return candidate
    }
  }
  home + "/.local/bin"
}

fn profile() -> String {
  let home = get "HOME"
  let name = std::path::basename (get "SHELL")
  if name == "zsh" {
    return home + "/.zshrc"
  }
  if name == "ksh" {
    return home + "/.kshrc"
  }
  if name == "fish" {
    return ""
  }
  if name == "bash" {
    if is_file (home + "/.bashrc") || is_file (home + "/.bash_profile") == false {
      return home + "/.bashrc"
    }
    return home + "/.bash_profile"
  }
  home + "/.profile"
}

# Escape literal path bytes for a double-quoted shell configuration value.
fn escaped(value: String) -> String {
  let value = replace value "\\" "\\\\"
  let value = replace value "\"" "\\\""
  let value = replace value "$" "\\$"
  replace value "`" "\\`"
}

fn path_line(directory: String) -> String {
  let home = get "HOME"
  if starts_with directory (home + "/") {
    return "export PATH=\"$HOME/" + escaped (trim_prefix directory (home + "/")) + ":$PATH\""
  }
  "export PATH=\"" + escaped directory + ":$PATH\""
}

fn ensure_path(directory: String, automatic: Bool) -> String / unknown, fs, env, stderr {
  if path_contains directory {
    return "ready"
  }
  if automatic == false {
    return "manual"
  }
  let file = profile
  if file == "" {
    return "manual"
  }
  if is_dir file {
    fail 1 ("install.sh: shell profile is a directory: " + file)
  }
  let line = path_line directory
  if is_file file && contains (read_text file) line {
    return file
  }
  append_text file ("\n# Added by ush install.sh\n" + line + "\n")?
  file
}

fn fetch(url: String, output: String) -> () / unknown, exec, fs, net, stderr, stdin, stdout, env {
  if starts_with url "file://" {
    cp (trim_prefix url "file://") output
  }
  else if exists "curl" {
    curl "-fsSL" "--proto" "=https" "--tlsv1.2" "--retry" "3" "--retry-delay" "2" url "-o" output
  }
  else if exists "wget" {
    wget "-q" "--https-only" "--secure-protocol=TLSv1_2" "--tries=3" "-O" output url
  }
  else {
    fail 1 "install.sh: curl or wget is required"
  }
  ()
}

fn release_url(repo: String, version: String, asset: String) -> String {
  if version == "latest" {
    return "https://github.com/" + repo + "/releases/latest/download/" + asset
  }
  "https://github.com/" + repo + "/releases/download/" + version + "/" + asset
}

fn expected_checksum(file: String, asset: String) -> String / unknown, fs, stderr {
  for line in lines (read_text file) {
    let field = 0
    let digest = ""
    for word in split (replace line "\t" " ") " " {
      if word != "" {
        if field == 0 {
          let digest = word
        }
        else if field == 1 && trim_prefix word "*" == asset {
          return digest
        }
        let field = field + 1
      }
    }
  }
  fail 1 ("install.sh: could not find checksum for " + asset)
}

let repo = option "USH_REPO" "UBSH_REPO" "ubugeeei/ush"
let repo = trim_suffix (trim_prefix (trim_prefix (trim_prefix repo "https://github.com/") "http://github.com/") "git@github.com:") ".git"
let version = option "USH_VERSION" "UBSH_VERSION" "latest"
let prefix = option "USH_PREFIX" "UBSH_PREFIX" ""
let directory = option "USH_BIN_DIR" "UBSH_BIN_DIR" ""
let download_url = option "USH_DOWNLOAD_URL" "UBSH_DOWNLOAD_URL" ""
let checksum_url = option "USH_CHECKSUM_URL" "UBSH_CHECKSUM_URL" ""
let automatic = option "USH_AUTO_PATH" "UBSH_AUTO_PATH" "1"
let pending = ""
for value in args {
  if pending != "" {
    match pending {
      "--version" => let version = value
      "--prefix" => let prefix = value
      "--bin-dir" => let directory = value
      "--download-url" => let download_url = value
      "--checksum-url" => let checksum_url = value
      _ => fail 1 "install.sh: invalid option state"
    }
    let pending = ""
  }
  else {
    if value == "--help" || value == "-h" {
      usage
      exit 0
    }
    else if value == "--no-modify-path" {
      let automatic = "0"
    }
    else if value == "--version" || value == "--prefix" || value == "--bin-dir" || value == "--download-url" || value == "--checksum-url" {
      let pending = value
    }
    else {
      fail 1 ("install.sh: unknown option: " + value)
    }
  }
}
if pending != "" {
  fail 1 ("install.sh: " + pending + " requires a value")
}
if get_or "USH_BRANCH" "__unset__" != "__unset__" || get_or "UBSH_BRANCH" "__unset__" != "__unset__" {
  fail 1 "install.sh: USH_BRANCH/UBSH_BRANCH is no longer supported; use USH_VERSION or build from source"
}
need "tar"
need "install"
let target = target
let directory = bin_directory directory prefix
let asset = "ush-" + target + ".tar.gz"
if download_url == "" {
  let download_url = release_url repo version asset
}
if checksum_url == "" {
  let checksum_url = release_url repo version "sha256sums.txt"
}
let work = temp_dir
let archive = work + "/ush.tar.gz"
let sums = work + "/sha256sums.txt"
eprint ("install.sh: downloading " + download_url)
fetch download_url archive
eprint ("install.sh: downloading " + checksum_url)
fetch checksum_url sums
let expected = expected_checksum sums asset
let actual = sha256 archive?
if actual != expected {
  fail 1 ("install.sh: checksum verification failed for " + asset)
}
eprint ("install.sh: verified checksum for " + asset)
let unpack = work + "/unpack"
mkdir_p unpack
tar "-xzf" archive "-C" unpack
let package = unpack + "/ush-" + target
if is_file (package + "/ush") == false && is_file (unpack + "/ush") {
  let package = unpack
}
if is_file (package + "/ush") == false {
  fail 1 "install.sh: release archive did not contain ush"
}
mkdir_p directory
install "-m" "755" (package + "/ush") (directory + "/ush")
if is_file (package + "/ush_lsp") {
  install "-m" "755" (package + "/ush_lsp") (directory + "/ush_lsp")
  print "ush_lsp installed to " + directory + "/ush_lsp"
}
let path_status = ensure_path directory (automatic != "0")?
print "ush installed to " + directory + "/ush"
if path_status == "ready" {
  print "ush is already on PATH. Try: ush --version"
}
else if path_status == "manual" {
  print "add this to your shell config, then restart your shell:"
  print path_line directory
}
else {
  print "added " + directory + " to PATH in " + path_status
  print "restart your shell or run: . \"" + path_status + "\""
}
print "quick check: " + directory + "/ush --version"
