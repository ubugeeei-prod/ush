{
  "name": "ush",
  "scopeName": "source.ush",
  "patterns": [
    {
      "include": "#expression"
    }
  ],
  "repository": {
    "expression": {
      "patterns": [
        {
          "name": "meta.command.ush",
          "begin": "(?:^\\s*|(?<=[=|(])\\s*|(?<=\\bmatch)\\s+)(?!(?:alias|allow_fail|as|async|await|break|const|continue|defer|do|effect|else|enum|export|extern|fail|fn|for|glob|if|impl|in|let|loop|match|mod|mut|print|pub|raise|return|shell|spawn|status_of|test|trait|try|type|unit|use|using|where|while|with)\\b)(\\$bin::[A-Za-z_][A-Za-z0-9_:]*|[A-Za-z_][A-Za-z0-9_:]*)(?=\\s+[^\\s=+<>{|])",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.ush"
            }
          },
          "end": "(?=$|[|)]|\\s+\\{\\s*$)",
          "patterns": [
            {
              "include": "#interpolated-string"
            },
            {
              "name": "string.quoted.triple.ush",
              "begin": "\"\"\"",
              "end": "\"\"\""
            },
            {
              "name": "string.quoted.double.ush",
              "begin": "\"",
              "end": "\"",
              "patterns": [
                {
                  "name": "constant.character.escape.ush",
                  "match": "\\\\."
                }
              ]
            },
            {
              "name": "string.quoted.single.ush",
              "begin": "'",
              "end": "'"
            },
            {
              "name": "comment.line.number-sign.ush",
              "match": "#.*$"
            },
            {
              "name": "meta.expression.ush",
              "begin": "\\(",
              "end": "\\)",
              "patterns": [
                {
                  "include": "#expression"
                }
              ]
            },
            {
              "name": "variable.other.ush",
              "match": "\\$(?:\\{(?:env::)?[A-Za-z_][A-Za-z0-9_]*\\}|(?:env::)?[A-Za-z_][A-Za-z0-9_]*)"
            },
            {
              "name": "constant.numeric.ush",
              "match": "(?<!\\S)-?[0-9]+(?:[A-Za-z_][A-Za-z0-9_]*)?(?!\\S)"
            },
            {
              "name": "constant.language.ush",
              "match": "(?<!\\S)(?:true|false)(?!\\S)"
            },
            {
              "name": "variable.parameter.ush",
              "match": "[A-Za-z_][A-Za-z0-9_]*:(?=\\s)"
            },
            {
              "name": "string.unquoted.ush",
              "begin": "(?=[^\\s()|])",
              "end": "(?=\\s|[|)])",
              "patterns": [
                {
                  "name": "variable.other.ush",
                  "match": "\\$(?:\\{(?:env::)?[A-Za-z_][A-Za-z0-9_]*\\}|(?:env::)?[A-Za-z_][A-Za-z0-9_]*)"
                }
              ]
            }
          ]
        },
        {
          "name": "meta.attribute.ush",
          "begin": "#\\[",
          "end": "\\]",
          "patterns": [
            {
              "name": "entity.other.attribute-name.ush",
              "match": "[A-Za-z_][A-Za-z0-9_]*"
            }
          ]
        },
        {
          "name": "comment.line.number-sign.ush",
          "match": "#.*$"
        },
        {
          "include": "#interpolated-string"
        },
        {
          "name": "string.quoted.triple.ush",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.double.ush",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ush",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.ush",
          "begin": "'",
          "end": "'"
        },
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.ush"
            },
            "2": {
              "name": "entity.name.function.ush"
            }
          }
        },
        {
          "name": "keyword.control.ush",
          "match": "\\b(alias|allow_fail|as|async|await|break|const|continue|defer|do|echo|effect|else|enum|export|extern|fail|fn|for|glob|if|impl|in|let|loop|match|mod|mut|pub|print|raise|return|shell|spawn|status_of|test|trait|try|type|unit|use|using|where|while|with)\\b"
        },
        {
          "name": "constant.language.ush",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "entity.name.type.ush",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "constant.numeric.ush",
          "match": "\\b[0-9]+\\b"
        },
        {
          "name": "variable.other.ush",
          "match": "\\$(?:\\{(?:env::)?[A-Za-z_][A-Za-z0-9_]*\\}|(?:env::)?[A-Za-z_][A-Za-z0-9_]*)"
        },
        {
          "name": "entity.name.function.ush",
          "match": "(?<=&)[A-Za-z_][A-Za-z0-9_:]*"
        },
        {
          "name": "entity.name.function.ush",
          "match": "\\b[a-z_][A-Za-z0-9_]*(?=\\()"
        },
        {
          "name": "keyword.operator.ush",
          "match": "::|->|=>|\\.\\.|[+*/=<>&|!$:-]"
        }
      ]
    },
    "interpolated-string": {
      "patterns": [
        {
          "name": "string.quoted.template.ush",
          "begin": "\\$\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.ush",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.ush",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.ush"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.ush"
                }
              },
              "contentName": "source.ush",
              "patterns": [
                {
                  "include": "#expression"
                }
              ]
            },
            {
              "name": "variable.other.ush",
              "match": "\\$(?:env::)?[A-Za-z_][A-Za-z0-9_]*"
            }
          ]
        },
        {
          "name": "string.quoted.interpolated.ush",
          "begin": "\\$\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.ush",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.ush",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.begin.ush"
                }
              },
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.interpolation.end.ush"
                }
              },
              "contentName": "source.ush",
              "patterns": [
                {
                  "include": "#expression"
                }
              ]
            },
            {
              "name": "variable.other.ush",
              "match": "\\$(?:env::)?[A-Za-z_][A-Za-z0-9_]*"
            }
          ]
        }
      ]
    }
  }
}
