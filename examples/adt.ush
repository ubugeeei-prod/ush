enum Result {
  Ok(String),
  Err(String),
}

enum Envelope {
  Wrap(Result),
  Missing,
}

let payload = Envelope::Wrap(Result::Ok("done"))

match payload {
  Envelope::Wrap(Result::Ok(message)) => echo message
  Envelope::Wrap(Result::Err(message)) => echo ("error: " + message)
  _ => echo "missing"
}
