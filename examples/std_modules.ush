use std::env::{get_or, set}
use std::fs::{read_text, tmpfile, write_text}
use std::path::{from_source, join}
use std::command::{capture, exists as command_exists}
use std::string::{replace, trim_suffix}

set "USH_EXAMPLE" "module-ready"

let file = tmpfile()
let nested = join "/tmp" "ush"
let example_root = from_source "."
let example_config = example_root.join("config.pkl")
let resolved_config = example_config.resolve()
write_text $file "from-fs"

echo (get_or "USH_EXAMPLE" "fallback")
echo (nested.dirname())
echo (file.exists())
echo (example_config.exists())
echo (resolved_config.basename())
echo (replace "hello.txt" ".txt" ".ush")
echo (trim_suffix "module.ush" ".ush")
echo (file.read_text())
echo (command_exists "sh")
echo (capture "printf '%s\n' from-command")
