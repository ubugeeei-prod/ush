enum Option {
  None,
  Some(Int),
}

fn classify(value: Int) -> String {
  if value < 3 {
    "small"
  } else {
    "large"
  }
}

echo (classify 2)

for item in 0..3 {
  echo $item
}

let items = [3, 4]
for item in items {
  echo $item
}

let pair = (5, 6)
for item in pair {
  echo $item
}

let mut count = 0
while count < 2 {
  echo ("while:" + count)
  count = count + 1
}

loop {
  echo "loop"
  break
}

let maybe = Option::Some(7)
if let Option::Some(it) = maybe && it == 7 {
  echo ("bound:" + it)
}
