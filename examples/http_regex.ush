use std::http::{download, get}
use std::path::{from_source, tmpfile}
use std::regex::{capture, find, replace as regex_replace}

let root = from_source "."
let sample = root.join("sample.json").resolve()
let url = "file://" + sample
let copy = tmpfile()
let text = get url

download url copy

echo (text.starts_with("{"))
echo ("module-ready".is_match("^module"))
echo (find "ush-v0.3.4" "v[0-9.]+")
echo (capture "release-v0.3.4" "v([0-9.]+)" 1)
echo (regex_replace "v0.3.4" "[.]" "-")
echo (copy.read_text().starts_with("{"))

copy.remove()
