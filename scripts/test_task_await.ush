# Check task status, repeated waits and standalone source diagnostics.
use $bin::*
use std::process::{arg, exec, redirect}
use std::fs::{temp_dir, write_text, read_text, remove}
use std::test::{assert_eq, assert}

fn compile(compiler: String, target: String, work: String) -> () / unknown, exec, env, fs, stderr, stdin, stdout, net {
  exec compiler ["compile", work + "/job.ush", "--target", target, "--checked-in", "-o", work + "/job.sh"]
  chmod "+x" (work + "/job.sh")
  remove (work + "/job.ush")
}

let compiler = arg 0
if compiler == "" {
  fail 1 "compiler path required"
}
let target = arg 1
if target == "" {
  let target = "sh"
}
let work = temp_dir
write_text (work + "/job.ush") """
fn build() -> Int / unknown, stderr {
  fail 23 "missing input"
}
let job = async build
print job.await
"""
compile compiler target work
assert_eq (redirect target [work + "/job.sh"] (work + "/out") (work + "/err")) 23
assert_eq (read_text (work + "/out")) ""
assert_eq (read_text (work + "/err")) """
job.ush:2: missing input (exit 23)
  fail 23 "missing input"
job.ush:5: command failed (exit 23)
  print job.await
"""

write_text (work + "/job.ush") """
use $bin::*
fn build() -> Int / unknown, exec, stderr {
  sleep "0.05"
  41
}
let job = async build
let first = async {
  let value = job.await
  value + 1
}
let second = async {
  let value = job.await
  value + 2
}
print first.await
print second.await
print job.await
print job.await
"""
compile compiler target work
assert_eq (redirect target [work + "/job.sh"] (work + "/out") (work + "/err")) 0
assert_eq (read_text (work + "/out")) "42\n43\n41\n41"
assert_eq (read_text (work + "/err")) ""

write_text (work + "/job.ush") """
fn build() -> Int / unknown, stderr {
  fail 23 "missing input"
}
let job = async build
let sibling = async {
  let value = job.await
  value
}
print sibling.await
"""
compile compiler target work
assert_eq (redirect target [work + "/job.sh"] (work + "/out") (work + "/err")) 23
assert_eq (read_text (work + "/out")) ""
assert_eq (read_text (work + "/err")) """
job.ush:2: missing input (exit 23)
  fail 23 "missing input"
job.ush:6: command failed (exit 23)
  let value = job.await
job.ush:9: command failed (exit 23)
  print sibling.await
"""
