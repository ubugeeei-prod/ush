# Compare vendored rustyline against non-yanked stable registry versions.
use $bin::*
use std::fs::{read_text, write_text, temp_dir}
use std::string::{lines, starts_with, trim_prefix, trim, split}
use std::process::output

fn value(file: String, key: String) -> String {
  for line in lines (read_text file) {
    if starts_with line key {
      return trim (trim_prefix line key)
    }
  }
  ""
}
fn first(text: String, separator: String) -> String {
  for part in split text separator {
    return part
  }
  ""
}
let pinned = trim_prefix (value "vendor/rustyline/UPSTREAM" "tag:") "v"
let vendored = std::string::trim_suffix (trim_prefix (value "vendor/rustyline/Cargo.toml" "version =") "\"") "\""
if pinned == "" || vendored != pinned {
  fail 1 "check_rustyline_upstream: UPSTREAM tag and vendored Cargo.toml version must agree"
}
let work = temp_dir
let index = work + "/index.jsonl"
curl "-fsSL" "--retry" "3" "https://index.crates.io/ru/st/rustyline" "-o" index
# jq performs JSON decoding and numeric version ordering; policy stays in ush.
let versions = output "jq" ["-sr", "[.[] | select(.yanked == false) | .vers | select(test(\"^[0-9]+[.][0-9]+[.][0-9]+$\")) | split(\".\") | map(tonumber)] | sort | .[] | map(tostring) | join(\".\")", index]
let mut latest = ""
let mut patch = ""
let major = first pinned "."
for version in lines versions {
  latest = version
  if first version "." == major {
    patch = version
  }
}
if latest == "" || patch == "" {
  fail 1 "check_rustyline_upstream: registry returned no stable versions"
}
let reviewed = value "vendor/rustyline/UPSTREAM" "reviewed:"
echo ("pinned: " + pinned + ", latest in major: " + patch + ", latest overall: " + latest)
if pinned != patch || pinned != latest && reviewed != "v" + latest {
  fail 1 ("vendored rustyline is behind upstream; review https://github.com/kkawakam/rustyline/releases/tag/v" + latest + " and update vendor/rustyline/UPSTREAM")
}
echo "Vendored rustyline is current in its major and upstream releases have been reviewed."
