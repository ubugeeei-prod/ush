# Validate typed package configuration and its generated Nix artifact.
use std::env::get_or
use std::fs::temp_dir
use std::process::{exec, status}

let compiler = get_or TYNIX tynix
let work = temp_dir
exec $compiler ["check", "flake.tynix"]
exec $compiler ["compile", "flake.tynix", "-o", work + "/flake.nix"]
if status cmp ["-s", "flake.nix", work + "/flake.nix"] != 0 {
  fail 1 "flake.nix is stale; run tynix compile flake.tynix -o flake.nix"
}
