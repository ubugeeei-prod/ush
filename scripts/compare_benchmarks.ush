# Alternate base/head runs on one machine; report geometric means in ns.
# jq is the JSON/numeric boundary; build, sampling, comparison and policy are ush.
use $bin::*
use std::env::{get, set}
use std::path::{cwd, resolve, from_cwd}
use std::fs::{temp_dir, read_text, append_text, remove}
use std::string::{lines, ends_with, trim_suffix, contains}
use std::process::{arg, output, redirect, status}
use std::io::eprint

fn report(text: String, summary: String) -> () {
  print text
  if summary != "" {
    append_text summary (text + "\n")
  }
}

fn build(checkout: String, package: String, suite: String, destination: String, target: String, work: String) -> String {
  cd checkout
  set "CARGO_TARGET_DIR" target
  let log = work + "/cargo.jsonl"
  let error_log = work + "/cargo.err"
  let code = redirect "cargo" ["bench", "--locked", "--no-run", "-p", package, "--bench", suite, "--message-format=json"] log error_log
  eprint (read_text error_log)
  if code != 0 {
    fail code ("benchmark build failed in " + checkout)
  }
  let binary = output "jq" ["-ser", "--arg", "suite", suite, "[.[] | select(.reason == \"compiler-artifact\" and .executable != null and .target.name == $suite) | .executable] | if length == 1 then .[0] else error(\"expected one benchmark executable\") end", log]?
  cp binary destination
  destination
}

fn cases(binary: String) -> String {
  let mut names = ""
  for line in lines (output binary ["--list"]) {
    if ends_with line ": benchmark" {
      names = names + trim_suffix line ": benchmark" + "\n"
    }
  }
  if names == "" {
    fail 1 ("No benchmarks in " + binary)
  }
  names
}

fn measure(binary: String, name: String) -> String {
  let run = temp_dir
  set "CRITERION_HOME" run
  let code = redirect binary ["--bench", "--exact", name, "--noplot", "--sample-size", "50", "--warm-up-time", "1.5", "--measurement-time", "2.5", "--nresamples", "10000"] (run + "/out") (run + "/err")
  if code != 0 {
    eprint (read_text (run + "/out"))
    eprint (read_text (run + "/err"))
    fail code ("benchmark failed: " + name)
  }
  let mut estimate = ""
  let mut count = 0
  for file in lines (find run "-path" "*/new/estimates.json") {
    estimate = file
    count = count + 1
  }
  if count != 1 {
    fail 1 ("expected one Criterion estimate for " + name)
  }
  let value = output "jq" ["-er", "(.slope // .mean).point_estimate | if type == \"number\" and . > 0 and isfinite then . else error(\"invalid timing estimate\") end", estimate]?
  rm "-rf" run
  value
}

fn geometric(first: String, second: String) -> String {
  output "jq" ["-nr", "--argjson", "a", first, "--argjson", "b", second, "($a * $b) | sqrt"]
}

fn compare(base: String, head: String, summary: String) -> Int {
  let before_cases = cases base + "\n"
  let after_cases = cases head + "\n"
  let mut seen = "\n"
  let mut failures = 0
  for name in lines (before_cases + after_cases) {
    let key = "\n" + name + "\n"
    if contains seen key == false {
      seen = seen + name + "\n"
      let in_base = contains ("\n" + before_cases) key
      let in_head = contains ("\n" + after_cases) key
      if in_base && in_head {
        # B-H-H-B balances warmup and clock drift, preserving 100 samples each.
        let b1 = measure base name
        let h1 = measure head name
        let h2 = measure head name
        let b2 = measure base name
        let before = geometric b1 b2
        let after = geometric h1 h2
        let ratio = output "jq" ["-nr", "--argjson", "a", after, "--argjson", "b", before, "$a / $b"]
        let row = printf "| %s | %.2f | %.2f | %.3f× |" name before after ratio
        report row summary
        if status "jq" ["-ne", "--argjson", "ratio", ratio, "$ratio > 1.25"] == 0 {
          failures = failures + 1
        }
      }
      else if in_head {
        let value = measure head name
        report (printf "| %s | — | %.2f | new |" name value) summary
      }
      else {
        let value = measure base name
        report (printf "| %s | %.2f | — | removed |" name value) summary
      }
    }
  }
  failures
}

let base_arg = arg 0
if base_arg == "" {
  fail 1 "usage: compare_benchmarks.sh BASE_CHECKOUT"
}
let head = cwd
let base = resolve (from_cwd base_arg)
let summary = get "GITHUB_STEP_SUMMARY"
report "## Paired Criterion measurements" summary
report "" summary
report "Base and PR binaries run on the same runner. The regression threshold is 1.25×." summary
report "" summary
report "| Benchmark | Base (ns) | PR (ns) | Ratio |" summary
report "| --- | ---: | ---: | ---: |" summary
let work = temp_dir
let mut failures = 0
for package in ["ush_shell", "ush_compiler"] {
  let mut suite = "parser"
  if package == "ush_compiler" {
    suite = "compile"
  }
  let before = build base package suite (work + "/base-" + suite) (head + "/target/bench-base") work
  let after = build head package suite (work + "/head-" + suite) (head + "/target") work
  failures = failures + compare before after summary
}
if failures > 0 {
  fail 1 ("Performance regression above 25% in " + failures + " benchmark(s)")
}
