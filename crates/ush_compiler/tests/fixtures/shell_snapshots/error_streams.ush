enum Problem {
  Nope,
}

fn fail() -> String / Problem, stderr {
  fail Problem::Nope
}

fn wrap(message: String) -> String {
  "<" + message + ">"
}

fn outer() -> String / Problem, stderr {
  let value = fail()?
  value
}

fn mixed() -> String / Problem, unknown, exec, fs, env, net, io {
  $ false
  $ wrap $ outer ()
}

fn awaited() -> String / Problem, stderr, task {
  let task = async fail ()
  let value = task.await
  value
}

print $ wrap $ awaited ()
